// ============================================================
// PUBH 402 — Blank Systems Map Template (.gv)
// ============================================================
//
// Welcome! This file is yours to build on. It starts out looking like a
// lot of instructions and not much else — that's normal. By the time
// you submit, every line below should be about your team's system, and
// none of this instruction block should still be here. Read it once,
// then get started; you don't need to have it memorized.
//
// INSTRUCTIONS — read this whole block before you start editing.
//
// 1. Fill in the team info fields directly below this instruction block
//    (team number, section, author names, health topic).
//
// 2. Rename "digraph YourSystemName" on the line below the team info to
//    something specific to your health problem. No spaces — use
//    underscores (e.g. digraph OpioidTreatmentAccess).
//
// 3. Add one node for each of your selected elements, in the
//    "--- Nodes ---" section. Format:
//
//      element_id [label="Human-readable element name"];  // Category: ...
//
//    - element_id: short, lowercase, underscores only, no spaces.
//    - label: the human-readable element name (what shows on the map).
//    - Comment: note which System Elements category the element comes
//      from (or that your team added it) so a reader knows where it fits.
//
//    Worked example (from the class Coffee Shop Example, not your topic —
//    see the DOT/GV Explainer resource page for the full walkthrough):
//
//      customers [label="Daily customer count"];  // Category: (example)
//
// 4. Add one directed edge for every causal relationship between two
//    elements, in the "--- Causal links ---" section. Format:
//
//      cause_id -> effect_id [label="+"];  // one-sentence explanation
//
//    - Polarity: "+" means the effect moves in the SAME direction as the
//      cause; "-" means it moves in the OPPOSITE direction.
//    - Delay: if there's a meaningful lag before the effect shows up, add
//      it to the label, e.g. [label="+ delay"].
//    - Always explain the edge in a same-line comment — a reader should
//      be able to tell why that arrow exists without asking your team.
//
//    Worked example, continuing the same one node above:
//
//      customers -> buzz [label="+"];  // More customers visiting generates more word-of-mouth and online reviews.
//
// 5. If your team identifies a feedback loop (a closed path where an
//    effect eventually feeds back on its own cause), box the looped
//    elements in a subgraph cluster, in the "--- Loop callouts ---"
//    section. Label it R# for a reinforcing loop or B# for a balancing
//    loop.
//
//    Worked example — the loop this closes once "buzz" also causes
//    "customers" (a second edge, not shown above, completing the
//    circle):
//
//      subgraph cluster_R1 {
//        label="R1 Reinforcing: word-of-mouth growth";
//        style="rounded,dashed";
//        color="gray40";
//        fontname="Arial";
//        fontsize=12;
//        customers;
//        buzz;
//        /* More customers generate more buzz; more buzz attracts more
//           customers. Both links are positive, so the effect compounds -
//           the simplest possible reinforcing structure. */
//      }
//
//    A commented-out, ready-to-copy version of this same block is in the
//    "--- Loop callouts ---" section below — copy its structure, rename
//    the ids and label to match your own loop, and delete the comment
//    marks.
//
// 6. Delete every placeholder/example line once you've replaced it with
//    your own content, including the three worked examples above. By the
//    time you submit, this file should contain only your team's system —
//    no leftover instructions or examples. (Don't worry — this is a
//    normal, expected step, not something you're likely to forget once
//    you're actually building your map.)
//
// 7. Check your file in an online Graphviz renderer (see the DOT/GV
//    Explainer resource page for recommended tools) before submitting.
//    A file that doesn't render is not a valid submission — rendering
//    early and often is the easiest way to avoid a last-minute surprise.
//
// ============================================================

// Team Number: 6
// Class Section: 51
// Team Member Names: Natalie Adi, Evelyn Herrera Ayala, Kelly Madrigal, Gabriela Quezada, Chelsea Umana
// Health Topic: Emergency Department Overcrowding

digraph EmergencyDepartmentOvercrowding {

  rankdir=TD;

  node [shape=box, style="rounded, filled", fillcolor="white", fontname="Arial"];

  edge [fontname="Arial", fontsize=10];

  // --- Nodes (your selected elements) ---

  // Natalie - Elements 1-3
  hospital_beds [label="Hospital Bed Capacity"]; // Infrastructure
  emergency_access [label="Emergency Care Access"]; // Infrastructure
  primary_capacity [label="Primary Care Visit Capacity"]; // Care 

// Evelyn - Elements 4-6
nursing_workforce_availability [label="Nursing Workforce Availability"]; // Workforce
health_it_interoperobility [label="Health Information Technology Interobility]; // Infrastructure
fee_for_service [label="Fee-for-Service Payment Prevalence"]; // Payment Models

// Kelly - Elements 7-9
transportation_barriers [label="Transportation Barriers in Low-Income Communities"]; // Structural Determinants
prescription_medication_coverage [label="Prescription or Medication Coverage"]; // Pharmaceuticals and Devices
federal_emtala [label="Federal EMTALA"]; // Federal and State Policy

// Gabriela - Elements 10-12 
primary_care_clinician_supply [label="Primary Care Clinician Supply"]; // Workforce
inequitable_health_resources [label="Inequitable Access to Health-Promoting Resources"]; // Structural Inequities
uninsured_population [label="Uninsured Population Size"]; // Financing/Insurance

  // --- Causal links (with polarity) ---
  // Natalie - Casual Links
  hospital_beds -> emergency_access [label="+"]; // More hospital beds free up space for incoming patients.
  primary_capacity -> emergency_access [label="+"]; // More primary care appointments reduce avoidable ED visits.
  // Gabriela - Casual Links 
  // primary_care_clincian_supply -> primary_capacity [label="+"]; // more primary care clinicians can increase the numberof patients who can be scheduled and seen.
  // inequitable_health_resources -> primary_capacity [label="-"]; // Unequal access to health-promoting resources can increase unmet health needs and place additional pressure on limited primary care capacity
  // uninsured_population -> prescription_medication_coverage [label="-"]; // Better medication coverage can reduce reliance on emergency care when health conditions can be managed with ongoing treatment.
  // Evelyn - Casual Links 
  // nursing_workforce_availability -> emergency_access [label="+"]; // More available nurses can support faster assessment, treatment, monitoring, and movement of emergency department patients.
  // health_it_interoperability -> emergency_access [label="+"]; // Better exchange of patient information can reduce delays caused by missing medical histories, test results, or other information.
  // fee_for_service_payment_prevalence -> primary_capacity [label="+, delay"]; // Greater reliance on payment per service may encourage providers to maintain or expand billable visit volume, which can affect primary care capacity over time.
  // Kelly - Casual Links 
  // transportation_barriers -> primary_capacity [label="-"]; // Transportation barriers can lead to missed or delayed primary care appointments, reducing the effective use of available primary care capacity.
  // primary_capacity -> transportation_barriers [label="-, delay"]; // Greater primary care capacity can increase the availability of care closer to patients, reducing the transportation burden over time.
  // prescription_medication_coverage -> emergency_access [label="-"]; // Better medication coverage can reduce reliance on emergency care when health conditions can be managed with ongoing treatment.
  // federal_emtala -> emergency_access [label="+"]; // EMTALA requires Medicare-participating hospitals with dedicated emergency departments to provide emergency screening and stabilizing treatment regardless of ability to pay.

// Proposed feedback loop R1
subgraph cluster_R1 {
label="R1 Reinforcing: Patient Flow and Nursing Capacity";
    style="rounded,dashed";
    color="gray40";
    fontname="Arial";
    fontsize=12;
    hospital_beds;
    emergency_access;
    nursing_workforce_availability;
    // Better patient flow may support nursing retention over time.
    // More nurses allow more hospital beds to be staffed.
    // More hospital beds improve emergency department patient flow.

  }
// Proposed feedback loop R2
subgraph cluster_R2 {
label="R2 Reinforcing: Primary-Care Equity and Workforce";
    style="rounded,dashed";
    color="gray40";
    fontname="Arial";
    fontsize=12;
    primary_care_clinician_supply;
    inequitable_health_resources;
    // More primary care clinicians can reduce unequal access to health-promoting resources, while inequitable access can make clinician recruitment and retention more difficult.

  }

   // Worked example, continuing the two nodes above — delete once you add your own:
  // customers -> buzz [label="+"];  // More customers visiting generates more word-of-mouth and online reviews.

  // --- Loop callouts (subgraph clusters) ---

  // Worked example — copy, rename, and uncomment if your team finds a loop.
  // (This one only closes into a real loop once "buzz -> customers" is
  // also added above — see the instructions block for the full picture.)
  //
  // subgraph cluster_R1 {
  //
  //   label="R1 Reinforcing: <short description>";
  //   style="rounded,dashed";
  //   color="gray40";
  //   fontname="Arial";
  //   fontsize=12;
  //
  //   customers;
  //   buzz;
  //
  //   /* One-sentence explanation of why this loop reinforces or balances. */
  //
  // }

}
